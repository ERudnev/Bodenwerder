namespace kubes
  namespace phys

    entity Atom
      one
        current: vec3
        prev: vec3 // Verlet planned
        mass: float

    entity Visual
      one
        atom: affects<Atom>
        actor: custody<rmmr::scene::actor::Sprite> // same Id as Node; Sprite alive ⇒ Node alive
        tint: vec3 // RGB boost for sprite (spawn / update)
      all
        >update() // broad pass, for each one maintain custody and move actor (or remove it)
