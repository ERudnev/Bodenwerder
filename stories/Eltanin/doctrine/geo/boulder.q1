import "rmmr/math"
import "rmmr/scene/root"
import "rmmr/scene/actors/mesh"
import "rmmr/system/core"
import "physics/clast"

namespace eltanin
  namespace geo

    entity Boulder
      struct Recipe
        mineral: integer // 0..15, Mineral::table() index
        diameterMeters: float // 0.5…10
        lump: float
        seed: integer
        kelvin: float
        erosion: float
      one
        body: custody<phys::Clast>
        actor: custody<rmmr::scene::actor::Mesh>
        mineral: integer
        diameterMeters: float
        kelvin: float
        erosion: float
      all
        >spawn(#rmmr::scene::Root, #system::Device, Pose, Recipe, vec3, vec3)->#
        *syncPose(~phys::Clast) // Node.pose ← Clast.restored (linear, not a reaction)
        *radiate(dt: float) // σAT⁴ into the void over dt seconds; MeshState.heat ← (kelvin, erosion)
