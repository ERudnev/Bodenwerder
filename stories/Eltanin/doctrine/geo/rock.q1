import "rmmr/math"
import "rmmr/scene/root"
import "rmmr/scene/actors/mesh"
import "rmmr/system/core"
import "physics/atomic"

namespace eltanin
  namespace geo

    using Mix as @external(C++ uint64_t; 16x4-bit voxel word)

    // Octree node on the 4 m lattice. scale is log2(edge in cells): 0 = one cell.
    // Empty children: homogeneous leaf. mix 0 = vacuum (omitted). Sparse: missing child = empty octant.
    struct Volume
      origin: index3
      scale: integer
      mix: Mix
      children: vector<Volume>

    // Mean mix is the typical voxel; dispersion only redistributes channels already present (zeros stay zero).
    // spotMeters — Mix patch wavelength (below 4 m is lost on the lattice). spotContrast 0 = uniform, 1 = strong spots.
    // lump 0 = sphere, 1 = potato (radius ±55%).
    struct Recipe
      mix: Mix
      spotMeters: float
      spotContrast: float
      diameterMeters: float
      lump: float
      seed: integer

    entity Rock
      one
        body: custody<phys::Atomic>
        actor: custody<rmmr::scene::actor::Mesh>
        volume: Volume
      all
        >spawn(#rmmr::scene::Root, #system::Device, Pose, Volume, vec3, vec3)->#
        >spawnGenerated(#rmmr::scene::Root, #system::Device, Pose, Recipe, vec3, vec3)->#
        >spawnIceSphere(#rmmr::scene::Root, #system::Device, Pose)->#
        >spawnPaletteTorus(#rmmr::scene::Root, #system::Device, Pose)->#
        !followBody(~phys::Atomic)->>linearPass(>all)
