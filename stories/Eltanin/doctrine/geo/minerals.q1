namespace eltanin
  namespace geo

    // Table order is the 16-channel basis (nibble index in a voxel). Palettes inside a channel are Rock's business.
    // Wider than OpenGL or physics need today.
    struct Mineral
      one
        name: string
        density: float // g/cm3
        scale: float // object-space 3D texture scale
        albedo: vec3
        roughness: float
        metalness: float
        hardness: float
        meltKelvin: float // solid → molten
        tintKelvin: float // albedo starts shifting toward incandescent
        glowKelvin: float // emissive glow of that heat color
        sootMul: float // albedo scale at full char; soot lives in [0 .. 0.2] and yields to incandescence; ice stays pale, rock/metal near soot black
      always table: vector<Mineral> = @external(Mayers)
