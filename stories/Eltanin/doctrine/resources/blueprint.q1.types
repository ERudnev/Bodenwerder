import "rmmr/resources/manager"
import "mech/blueprint"

namespace eltanin
  namespace resource
    namespace blueprint

      // Construction schema on the Unit shelf. Payload = mech::Blueprint.
      // Disk: blueprints/_unnamed.blueprint | ships/*.blueprint | prefabs/*.blueprint
      feature Asset of rmmr::resource::Unit
        one
          data: mech::Blueprint

      feature Loader of Asset
        one
          file: filename // relative to kit; under blueprints/ (+ ships/ or prefabs/), suffix .blueprint
          >load()
          >save()
