import "rmmr/math"
import "rmmr/resources/manager"
import "rmmr/resources/geometry"

namespace eltanin
  namespace resource
    namespace atomic

    using Reference as rmmr::resource::Unit::Reference

    feature Asset of rmmr::resource::Unit
      struct Face
        name: string
        indices: vector<integer>
      one
        // Game meters in body space (no unit-normalize). kube4m: diameter 4 → corners ±2.
        points: vector<Pos>
        faces: vector<Face>
        visualizer: #rmmr::resource::geometry::Asset
