import "rmmr/resources/runtimes"
import "rmmr/resources/manager"
import "mech/blueprint"
import "mech/mount"

namespace eltanin
  namespace resource

    using Unit as rmmr::resource::Unit

    // Story-owned asset entry points — not rmmr primitives.
    component Assets of rmmr::resource::Assets
      one
        // Registers Unit+Blueprint; loads from disk when the resolved file exists.
        >add_blueprint(Unit::Name, filename)->#mech::Blueprint
        // Registers Unit+Mount; loads from disk when the resolved file exists.
        >add_mount(Unit::Name, filename)->#mech::Mount
