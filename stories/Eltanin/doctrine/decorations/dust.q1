import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "rmmr/resources/geometry"
import "rmmr/resources/materials"
import "rmmr/resources/texpack"
import "physics/body"

namespace eltanin
  namespace decorations

    // Lost-mass vis: no Body, no Compound. Tumbles, cools, vanishes. Not salvage.
    feature Dust of rmmr::scene::actor::Mesh
      struct Resources
        scrap: #rmmr::resource::geometry::Asset
        hull: #rmmr::resource::material::Asset
        mech: #rmmr::resource::texpack::Pack
      one
        linear: vec3
        omega: vec3
        temperature: Kelvins
        half: vec3
        life: seconds
      all
        resources: Resources?
        >bindResources()
        >update(dt: seconds)
        >spawn(Pose, half: vec3, linear: vec3, omega: vec3, temperature: Kelvins)->#
