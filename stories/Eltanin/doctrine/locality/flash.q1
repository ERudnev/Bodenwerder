import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "physics/body"
import "physics/rigid"
import "locality/thing"

namespace eltanin
  namespace locality

    feature Flash of Thing
      struct Effect
        struct Kinetic
          strength: float
          radius: float
          core: float // visual seed; 0.1 m at class 10
          duration: seconds
        struct Thermal
          temperature: Kelvins
          energy: float
          radius: float
          duration: seconds
        struct Fracture
          yield: float
          radius: float
        kinetic: Kinetic
        thermal: Thermal
        fracture: Fracture
      one
        effect: Effect
        shock: custody<rmmr::scene::actor::Mesh>
        plasma: custody<rmmr::scene::actor::Mesh>
        elapsed: seconds // wave clock; physics ticks, not Thing.now
      all
        >update()
        >spawnAsExplosion(position: vec3, strength: float)-># // warhead class; 10 = anti-frigate bang
        >spawnAsThermal(position: vec3, strength: float)-># // plasma dump; heat only; 10 = same thermal class
        *apply(~phys::rigid::Crystal, ~phys::rigid::Solid)
