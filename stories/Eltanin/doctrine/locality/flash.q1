import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "rmmr/resources/geometry"
import "rmmr/resources/materials"
import "physics/body"
import "physics/rigid"
import "locality/thing"

namespace eltanin
  namespace locality

    feature Flash of Thing
      struct Resources
        sphere: #rmmr::resource::geometry::Asset
        flash: #rmmr::resource::material::Asset
        flashGlow: #rmmr::resource::material::Asset
        brisance: #rmmr::resource::material::Asset
      struct Effect
        struct Kinetic
          strength: float // overpressure Pa at atten 1; spawn class is mapped in C++
          radius: float
          core: float // visual seed; 0.1 m at class 10
          duration: seconds // front speed = radius/duration; no extra class→speed curve
        struct Thermal
          temperature: Kelvins
          energy: float
          radius: float
          duration: seconds
        struct Brisance
          yield: float // cohesion wound; class 10 matches the old kinetic cohesion shell
          radius: float
          duration: seconds // 0.2 s at class 10
        kinetic: Kinetic
        thermal: Thermal
        brisance: Brisance
      one
        effect: Effect
        shock: custody<rmmr::scene::actor::Mesh>
        plasma: custody<rmmr::scene::actor::Mesh>
        field: custody<rmmr::scene::actor::Mesh>
        linear: vec3 // drift; actors stay identity orientation
        elapsed: seconds // wave clock; physics ticks, not Thing.now
      all
        resources: Resources?
        >bindResources()
        >update()
        >spawnAsExplosion(position: vec3, linear: vec3, strength: float)-># // kinetic only; 1 = sailor at the navel, 10 = half a frigate if inside
        >spawnAsThermal(position: vec3, linear: vec3, strength: float)-># // heat only; 10 = same class, no shock
        >spawnAsBrisance(position: vec3, linear: vec3, strength: float)-># // cohesion only; 10 = same wound as the bang
        *apply(~phys::rigid::Crystal, ~phys::rigid::Solid) // kinetic and brisance also reach decorations::Dust during the wave
