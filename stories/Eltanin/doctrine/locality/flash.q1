import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "rmmr/resources/geometry"
import "rmmr/resources/materials"
import "physics/body"
import "physics/rigid"
import "locality/thing"

namespace eltanin
  namespace locality

    feature Flash of Thing
      struct Resources
        sphere: #rmmr::resource::geometry::Asset
        flash: #rmmr::resource::material::Asset
        flashGlow: #rmmr::resource::material::Asset
        brisance: #rmmr::resource::material::Asset
      struct Effect
        struct Kinetic
          strength: float // overpressure Pa at atten 1; derived from channel meters
          radius: float
          core: float // visual seed; scaled from channel meters
          duration: seconds // front speed = radius/duration; no extra class→speed curve
        struct Thermal
          temperature: Kelvins
          energy: float
          radius: float
          duration: seconds
        struct Brisance
          yield: float // cohesion wound; scaled from channel meters
          radius: float
          duration: seconds
        kinetic: Kinetic
        thermal: Thermal
        brisance: Brisance
      struct Channels
        kinetic: float // meters of kinetic radius; 0 = off
        thermal: float // meters of plasma radius; 0 = off
        brisance: float // meters of brisance radius; 0 = off
      one
        effect: Effect
        shock: custody<rmmr::scene::actor::Mesh>
        plasma: custody<rmmr::scene::actor::Mesh>
        field: custody<rmmr::scene::actor::Mesh>
        linear: vec3 // drift; actors stay identity orientation
        elapsed: seconds // wave clock; physics ticks, not Thing.now
      all
        resources: Resources?
        >bindResources()
        >update()
        >spawn(position: vec3, linear: vec3, channels: Channels)-># // one Flash; channel values are meters
        *apply(~phys::rigid::Crystal, ~phys::rigid::Solid) // kinetic and brisance also reach decorations::Dust during the wave
