namespace eltanin
  namespace locality

    feature Flash of Thing
      struct Effect
        struct Kinetic
          strength: float
          radius: float
        struct Thermal
          temperature: Kelvins
          energy: float
          radius: float
        struct Fracture
          yield: float
          radius: float
        duration: seconds
        kinetic: Kinetic
        thermal: Thermal
        fracture: Fracture
      one
        effect: Effect
        actor: custody<rmmr::scene::actor::Mesh>
      all
        >update()
        >spawnAsExplosion(position: vec3, strength: float)->#
