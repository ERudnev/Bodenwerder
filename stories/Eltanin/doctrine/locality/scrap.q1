import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "rmmr/resources/geometry"
import "rmmr/resources/materials"
import "rmmr/resources/texpack"
import "locality/thing"
import "physics/body"
import "physics/rigid"

namespace eltanin
  namespace locality

    // Dead hull scrap: Body + box Solid + Eltanin::wreck. Physics cohesion for split only. Not geo, not Crystal.
    feature Scrap of locality::Thing
      enum Lineage : common, volume, terminal
      struct Resources
        scrap: #rmmr::resource::geometry::Asset
        wreck: #rmmr::resource::material::Asset
        mech: #rmmr::resource::texpack::Pack
      one
        body: custody<phys::rigid::Solid>
        actor: custody<rmmr::scene::actor::Mesh>
        gpuKelvin: Kelvins // last writeHeats; never read back from GPU
        meshFromBody: Pose // actor = body.pose composed with this; identity for cube scrap
        lineage: Lineage
      all
        resources: Resources?
        >bindResources()
        >update(dt: seconds)
        >spawn(Pose, halfExtents: vec3, mass: float, linear: vec3, omega: vec3, cohesion: float, temperature: Kelvins, lineage: Lineage)->#
        >spawnMesh(actor: Pose, body: Pose, halfExtents: vec3, mass: float, linear: vec3, omega: vec3, cohesion: float, temperature: Kelvins, occurrences: vector<rmmr::scene::actor::Mesh::Occurrence>, latticeStep: float, lineage: Lineage)->#
        *radiate(dt: seconds) // same 4 s remaining² as thermal Dust; floor at sky
        *followBody()
