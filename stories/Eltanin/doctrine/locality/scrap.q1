import "rmmr/math"
import "rmmr/scene/actors/mesh"
import "rmmr/resources/geometry"
import "rmmr/resources/materials"
import "rmmr/resources/texpack"
import "locality/thing"
import "physics/body"
import "physics/rigid"

namespace eltanin
  namespace locality

    // Hull wreckage: Body + box Solid + Eltanin::scrap cube (±Z face / four cut rims). Not geo, not Crystal.
    // Born without Compound (uncertain: ghost for collisions, still Solid for Flash/gravity). settleAt is Thing.now of the one occupancy probe; Compound present ⇒ salvage.
    // Cohesion 0 on the parent was the failed joint. The lump is a new body and starts with modest strength.
    feature Scrap of locality::Thing
      struct Resources
        scrap: #rmmr::resource::geometry::Asset
        hull: #rmmr::resource::material::Asset
        mech: #rmmr::resource::texpack::Pack
      one
        body: custody<phys::rigid::Solid>
        actor: custody<rmmr::scene::actor::Mesh>
        settleAt: seconds
      all
        resources: Resources?
        >bindResources()
        >update()
        >spawn(Pose, halfExtents: vec3, mass: float, linear: vec3, omega: vec3, cohesion: float, temperature: Kelvins)->#
        *followBody()
