import "rmmr/math"
import "rmmr/scene/root"
import "rmmr/scene/actors/mesh"
import "rmmr/system/core"
import "locality/geo/minerals"
import "locality/thing"
import "physics/body"
import "physics/rigid"

namespace eltanin
  namespace locality
    namespace geo

    using Mix as @external(C++ uint64_t; 16x4-bit voxel word)

    // Octree node on the 4 m lattice. scale is log2(edge in cells): 0 = one cell.
    // Empty children: homogeneous leaf. mix 0 = vacuum (omitted). Sparse: missing child = empty octant.
    struct Volume
      origin: index3
      scale: integer
      mix: Mix
      children: vector<Volume>

    // Mean mix names the minerals; zeros stay zero. Domains are geological patches, not grain noise.
    // spotMeters — clean-zone width (≈ 10–50% of diameter). spotContrast 0 = alloy, 1 = sharp contacts.
    // lump 0 = sphere, 1 = triaxial potato with knobs and pits.
    struct GeneralizedRecipe
      mix: Mix
      radius: float
      lump: float
      seed: integer
      spotMeters: float
      spotContrast: float
      always ?homogenous(Mineral::Index)->Mix

    // Large rock: Body + Crystal + octree Volume. Small debris → Boulder.
    feature Rock of locality::Thing
      one
        body: custody<phys::rigid::Crystal>
        actor: custody<rmmr::scene::actor::Mesh>
        volume: Volume
      all
        *update()
        >spawn(#rmmr::scene::Root, #system::Device, Pose, Volume, vec3, vec3)->#
        >spawnGenerated(#rmmr::scene::Root, #system::Device, Pose, GeneralizedRecipe, vec3, vec3)->#
        >spawnIceSphere(#rmmr::scene::Root, #system::Device, Pose)->#
        >spawnPaletteTorus(#rmmr::scene::Root, #system::Device, Pose)->#
        >spawnLavaBrick(#rmmr::scene::Root, #system::Device, Pose)->#
        >spawnIceBlob(#rmmr::scene::Root, #system::Device, Pose)->#
        *radiate(dt: float)
        !followBody(~phys::Body)->>linearPass(>all)
