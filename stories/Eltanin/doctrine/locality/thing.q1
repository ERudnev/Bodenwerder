import "rmmr/scene/root"

namespace eltanin
  namespace locality

    // Local scene pulse lives in Thing Global (not per-instance Quantum).
    //   Product::onFrame wall dt → locality dt (paused, timeScale), then physics and >update share that dt.
    // Quantum.bornAt snapshots now at create.
    // scene — the one gameplay Root; born with the Realm (always >assemble).
    entity Thing
      always
        >assemble() -> all
      one
        bornAt: seconds
      all
        now: seconds
        timeScale: float // wall dt → locality dt
        scene: #rmmr::scene::Root
        >update(dt: seconds)
        *followBodies() // after phys ticks: Node.pose ← Body; missing ward → skip (lock). lifetime = custody pact.
