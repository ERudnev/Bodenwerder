import "rmmr/scene/root"

namespace eltanin
  namespace locality

    // Local scene host. Universe time is fundamental::Thing.now; Quantum.bornAt snapshots it at create.
    //   Product::onFrame wall dt → World.rate(warp) → Thing >update, then physics and >update share that dt.
    // scene — the one gameplay Root; born with the Realm (always >setup).
    entity Thing
      always
        >setup() -> all
      one
        bornAt: seconds
      all
        scene: #rmmr::scene::Root
        >update(dt: seconds)
        *followBodies() // after phys ticks: Node.pose ← Body; Construct GPU cohesion/heat if Crystal.visualHurtStale. missing ward → skip (lock). lifetime = custody pact.
