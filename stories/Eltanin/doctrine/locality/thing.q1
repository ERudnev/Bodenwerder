namespace eltanin
  namespace locality

    // Local scene pulse lives in Thing Global (not per-instance Quantum).
    //   Product::onFrame → physics Stewarding, then >update (Writing) advances now and locality features.
    // Quantum.bornAt snapshots now at create.
    entity Thing
      one
        bornAt: int64
      all
        now: int64 // wall µs
        >update(dtUs: int64)
