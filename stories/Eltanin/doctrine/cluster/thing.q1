namespace eltanin
  namespace cluster

    // Universe clock of the Cluster. Global.now.
    //   Product::onFrame wall dt → World.rate(warp) → >update(simDt): now += simDt.
    // Locality Thing.bornAt snapshots this now at create.
    entity Thing
      always
        >setup() -> all
      all
        now: seconds
        >update(dt: seconds)
