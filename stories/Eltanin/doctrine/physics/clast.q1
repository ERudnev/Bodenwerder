import "rmmr/math"
import "physics/particle"

namespace eltanin
  namespace phys

    // Cheap rigid debris: 6 particles on an axis-aligned octahedron. No COM particle, no Horn.
    entity Clast
      one
        particles: vector<#phys::Particle>
        restRadius: float
        restored: rmmr::Pose
      all
        *satisfy(~Particle) // octahedron triad restore: mean COM, axes, signed quat
