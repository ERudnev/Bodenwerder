import "rmmr/math"
import "physics/body"

namespace eltanin
  namespace phys
    namespace rigid

      // Graphics front faces are CCW: (b−a)×(c−a) points toward the camera / outward.
      // Physics uses the same winding. Hull faces: 2-vert capsule, or convex polygon (triangle/quad). The body need not be convex.
      // Rest-space BVH is cooked in C++ on Hull from faces+shape; queries run in the body's frame.
      struct Hull
        struct Face
          points: vector<integer> // into Crystal.shape
          normal: vec3
          thickness: float // receive depth behind the plane (Rock ~ COM). Geometric shell / BVH pad only when twoSided (plates) or 2-vert (capsule radius)
          twoSided: bool // 3+: Construct membranes receive from both sides; Rock stays a solid half-space. 2-vert capsule ignores this.
        faces: vector<Face>

      feature Solid of phys::Body
        enum Kind : sphere, box
        one
          center: Particle
          prevOri: quat
          forceAngular: vec3
          kind: Kind
          halfExtents: vec3 // body-frame; sphere ignores this, Body.radius is the bound

      // Death-ray kinematics: one Particle, Verlet prev→position. Not an Occupant; own CCD phase. Rays do not see each other.
      feature Ray of phys::Body
        one
          core: Particle

      feature Crystal of phys::Body
        one
          particles: vector<Particle>
          shape: vector<vec3> // Immutable particle locals in the body's frame; origin is not COM
          com: vec3 // restCOM = Σ(m·shape)/Σm, computed once for this shape
          hull: Hull
          visualHurtStale: bool // Construct GPU cohesion/heat; Rocks ignore
          =debugAddImpulse(imp: vec3)
          =setMotion(pose: Pose, linear: vec3, omega: vec3) // Place shape by Pose; prev = position − (linear + ω×(position−currentCOM))·dt
          all *restore() // Horn → Pose into Body; particles untouched
          all *applyRestored() // position += k·(goal−position); prev += same (velocity preserved through projection)

      attribute CelestialGravity of Crystal
        one
          averageRadius: float
          surfaceAcceleration: float
          ?roundOrbitHelper(distance: float)->float
        all *apply(~Crystal)
