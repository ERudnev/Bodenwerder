import "rmmr/math"
import "physics/body"

namespace eltanin
  namespace phys
    namespace rigid

      entity Crystal
        one
          particles: vector<Particle>
          shape: vector<vec3> // Immutable particle locals in the body's frame; origin is not COM
          com: vec3 // restCOM = Σ(m·shape)/Σm, computed once for this shape
          restored: Body // Cache reconstructed from particles
          =debugAddImpulse(imp: vec3)
          =setMotion(pose: Pose, linear: vec3, omega: vec3) // Place shape by Pose; prev = position − (linear + ω×(position−currentCOM))·dt

      feature Octa of Crystal
        all *satisfy(~Crystal) // Triad → Pose; position = (1−k)·current + k·(pose * shape)

      feature Horned of Crystal
        all *satisfy(~Crystal) // Horn on q/p; same pull; Pose origin is currentCOM − R·restCOM

      attribute CelestialGravity of Crystal
        one
          averageRadius: float
          surfaceAcceleration: float
          ?roundOrbitHelper(distance: float)->float
        all *apply(~Crystal)
