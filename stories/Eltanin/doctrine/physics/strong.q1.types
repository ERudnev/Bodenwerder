import "rmmr/math"
import "physics/particle"

namespace eltanin
  namespace phys
    namespace strong

      // Soft pin: holds one Particle at a fixed world `point`.
      // Born where the particle is (`>pin` snapshots current → point).
      // Enforced in the constraint wave with Atomic / Gluon. Missing particle → seppuku.
      entity Nail
        one
          particle: affects<phys::Particle>
          point: vec3
        all
          >pin(#phys::Particle)->#
          *satisfy(~phys::Particle) // soft pin toward `point`; missing particle → seppuku

      // Soft glue: pulls 2+ Particles toward their shared COM (bodies may differ).
      // `>clue` takes one seed Particle, gathers every Particle within clueTolerance into `particles`.
      // Dead links dropped each tick; size < 2 → seppuku.
      entity Gluon
        one
          particles: vector<affects<phys::Particle>>
        all
          >clue(#phys::Particle)->#
          *satisfy(~phys::Particle) // soft COM glue; size < 2 → seppuku
