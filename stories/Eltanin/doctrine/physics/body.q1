import "rmmr/math"

namespace eltanin
  namespace phys

    using Kelvins as float

    struct Matter
      position: dvec3
      mass: float
      temperature: Kelvins
      cohesion: float
      ?hp()->float
      ?thermalEnergy()->float

    struct Particle of Matter
      always dt: float = 0.01
      prev: dvec3
      force: vec3
      ?velocity()->dvec3
      ?impulse()->vec3

    // World-facing Matter cache. Ball and Crystal are features of the same id.
    entity Body
      one
        position: dvec3
        mass: float
        temperature: Kelvins
        cohesion: float
        orientation: quat
        radius: float
        hitpoints: float
        ?hp()->float
        ?thermalEnergy()->float
        ?pose()->rmmr::Pose
        =pose(rmmr::Pose)
