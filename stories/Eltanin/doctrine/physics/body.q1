import "rmmr/math"

namespace eltanin
  namespace phys

    using Kelvins as float

    struct Matter
      position: dvec3
      mass: float
      temperature: Kelvins
      cohesion: float
      ?hp()->float
      ?thermalEnergy()->float

    struct Particle of Matter
      prev: dvec3
      force: dvec3

    // Pose only: position and orientation. Velocities live on Solid, Crystal, Ray and Planet — not here.
    // compound = collision cohort anchor; solo body points at itself.
    entity Body
      one
        position: dvec3
        orientation: quat
        totalMass: float
        radius: float
        compound: #Body
        ?pose()->rmmr::Pose
        =pose(rmmr::Pose)
