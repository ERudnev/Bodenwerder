import "rmmr/math"

namespace eltanin
  namespace phys

    using Kelvins as float

    struct Matter
      position: dvec3
      mass: float
      temperature: Kelvins
      cohesion: float
      ?hp()->float
      ?thermalEnergy()->float

    struct Particle of Matter
      prev: dvec3
      force: vec3

    // World-facing kinematics cache. Solid, Crystal and Ray are features of the same id.
    // compound = collision cohort anchor; solo body points at itself.
    entity Body
      one
        position: dvec3
        orientation: quat
        totalMass: float
        radius: float
        compound: #Body
        ?pose()->rmmr::Pose
        =pose(rmmr::Pose)
