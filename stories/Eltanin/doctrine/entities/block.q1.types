import "rmmr/math"
import "rmmr/scene/root"
import "rmmr/scene/actors/mesh"
import "physics/atomic"
import "mech/semantics"

namespace eltanin

  entity Block
    one
      body: custody<phys::Atomic>
      actor: custody<rmmr::scene::actor::Mesh>
    all
      >spawnPlate(#rmmr::scene::Root, Pose, mech::plate::shape, mech::role, one<rmmr::scene::actor::Mesh>, one<rmmr::scene::actor::MeshState>)->#
      >spawnFrame(#rmmr::scene::Root, Pose, mech::frame::shape, one<rmmr::scene::actor::Mesh>, one<rmmr::scene::actor::MeshState>)->#
      >spawnInner(#rmmr::scene::Root, Pose, mech::frame::shape, mech::role, one<rmmr::scene::actor::Mesh>, one<rmmr::scene::actor::MeshState>)->#
      !followBody(~phys::Atomic)->>linearPass(>all)
