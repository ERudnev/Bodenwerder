import "rmmr/math"
import "rmmr/scene/root"
import "rmmr/scene/actors/mesh"
import "physics/atomic"
import "mech/semantics"

namespace eltanin

  entity Block
    one
      body: custody<phys::Atomic>
      actor: custody<rmmr::scene::actor::Mesh>
    all
      >spawnPlate(#rmmr::scene::Root, Pose, mech::plate::shape, mech::slot::plate, one<rmmr::scene::actor::Mesh>)->#
      >spawnFrame(#rmmr::scene::Root, Pose, mech::frame::shape, one<rmmr::scene::actor::Mesh>)->#
      >spawnInner(#rmmr::scene::Root, Pose, mech::inner::shape, mech::slot::inner, one<rmmr::scene::actor::Mesh>)->#
      >spawnWing(#rmmr::scene::Root, Pose, mech::wing::shape, mech::slot::wing, one<rmmr::scene::actor::Mesh>)->#
      !followBody(~phys::Atomic)->>linearPass(>all)
