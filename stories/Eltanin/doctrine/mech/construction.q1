import "semantics"

namespace eltanin
  namespace mech

    struct Construction
      struct Primitive
        using Id as integer
        struct Point
          gridPos: index3
          mass: float
        struct Welded of Point
          strength: float
        loop: vector<Welded>
        thickness: float
      struct Knot of Primitive
        welded: vector<integer> // Crystal / evaluatedParticles indices at this gridPos; bound in compileParticles
      knots: map<Primitive::Id, Knot>
      ribs: map<Primitive::Id, Primitive>
      membranes: map<Primitive::Id, Primitive>
      plates: map<Primitive::Id, Primitive>
      volumes: map<Primitive::Id, vector<Primitive>>
      evaluatedParticles: vector<Primitive::Point>
