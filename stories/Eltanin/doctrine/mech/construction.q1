import "rmmr/scene/actors/mesh"
import "rmmr/resources/manager"
import "physics/body"
import "physics/rigid"
import "semantics"

namespace eltanin
  namespace mech

    struct Construction
      struct Primitive
        using Id as integer
        struct Point
          gridPos: index3
          mass: float
        struct Welded of Point
          strength: float
        loop: vector<Welded>
        thickness: float
      knots: umap<Primitive::Id, Primitive>
      ribs: umap<Primitive::Id, Primitive>
      membranes: umap<Primitive::Id, Primitive>
      plates: umap<Primitive::Id, Primitive>
      volumes: umap<Primitive::Id, vector<Primitive>>
      evaluatedParticles: vector<Primitive::Point>

    entity Construct
      struct ActorFragments
        struct OfKnot
          knot: Construction::Primitive::Id
          quark: skeleton::Corner
        struct OfRib
          rib: Construction::Primitive::Id
          quark: skeleton::Halfrib
          at: index3
        struct OfMembrane
          membrane: Construction::Primitive::Id
          quark: skeleton::Membrane
          at: index3
        struct OfPlate
          plate: Construction::Primitive::Id
          mount: rmmr::resource::Unit::Name
          transform: space::Transform
        struct OfVolume
          volume: Construction::Primitive::Id
          mount: rmmr::resource::Unit::Name
          transform: space::Transform
        ofKnot: vector<OfKnot>
        ofRib: vector<OfRib>
        ofMembrane: vector<OfMembrane>
        ofPlate: vector<OfPlate>
        ofVolume: vector<OfVolume>
      one
        body: custody<phys::rigid::Crystal>
        actor: custody<rmmr::scene::actor::Mesh>
        fragments: ActorFragments
        construction: Construction
      all
        !followBody(~phys::Body)->>linearPass(>all)
