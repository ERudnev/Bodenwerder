import "rmmr/resources/manager"
import "semantics"

namespace eltanin
  namespace mech

    struct Attachment
      points: vector<index3> // just points in discrete local space

    // Library entry: placeable external equipment. Visual = soft meshpack link (placeholder).
    // Disk: fittings/mounts/*.json (classic JSON).
    feature Mount of rmmr::resource::Unit
      struct TempMesh
        pack: rmmr::resource::Unit::Name
        entry: string
      one
        name: string
        author: string
        attachment: Attachment
        tempMesh: TempMesh
        role: Role?
        file: filename // kit-relative; under fittings/mounts/
        >load()
        >save()
