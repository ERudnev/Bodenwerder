import "rmmr/resources/manager"
import "rmmr/resources/meshpack"
import "semantics"

namespace eltanin
  namespace mech

    // External mount footprint on plate sockets (armor / hardpoints).
    struct Socket
      struct Element
        shape: plate::shape
        pose: Pose
      profile: vector<Element>

    // Library entry: placeable external equipment. Visual = soft meshpack link (placeholder).
    feature Mount of rmmr::resource::Unit
      // Soft link: pack Unit::Reference (id + Name backup) + entry key in meshpack::Asset.entries.
      struct TempMesh
        pack: rmmr::resource::meshpack::Reference
        entry: string
      one
        name: string
        author: string
        socket: Socket
        tempMesh: TempMesh
