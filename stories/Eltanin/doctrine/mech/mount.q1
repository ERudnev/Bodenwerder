import "rmmr/math"
import "rmmr/resources/manager"
import "semantics"

namespace eltanin
  namespace mech

    struct Attachment
      points: vector<index3> // just points in discrete local space
      ?flatMounted()->bool // true → one lattice plane (externals); false → volume (internals)

    struct LatticeHull
      thickness: float
      faces: vector<vector<integer>> // loops of indices into Attachment.points

    struct Box
      min: vec3
      max: vec3

    struct Element
      name: string
      mass: float // authored kg; not derived from box volume
      latticeHull: LatticeHull?
      box: Box?

    // Disk: fittings/<dir>/*.json
    feature Mount of rmmr::resource::Unit
      struct PresentationGeometry
        pack: rmmr::resource::Unit::Name
        entry: string // JSON: "pack::entry" (first :: splits)
      one
        name: string
        author: string
        attachment: Attachment
        elements: vector<Element>
        presentationGeometry: vector<PresentationGeometry>
        role: Role?
        file: filename // kit-relative; under fittings/
        ?mass()->float // sum of element masses; no root mass on disk
        >load()
        >save()
