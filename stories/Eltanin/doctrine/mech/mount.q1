import "rmmr/resources/manager"
import "semantics"

namespace eltanin
  namespace mech

    struct Attachment
      points: vector<index3> // just points in discrete local space
      ?flatMounted()->bool // true → one lattice plane (externals); false → volume (internals)

    struct Collision
      enum Shape capsule, volume // volume reserved for 3-D attachments
      shape: Shape
      parameter1: float // capsule: shell meters both sides of the planar loop

    // Library entry: placeable external equipment. Visual = soft meshpack link (placeholder).
    // Disk: fittings/mounts/*.json (classic JSON).
    feature Mount of rmmr::resource::Unit
      struct TempMesh
        pack: rmmr::resource::Unit::Name
        entry: string
      one
        name: string
        author: string
        attachment: Attachment
        collision: Collision
        tempMesh: TempMesh
        role: Role?
        file: filename // kit-relative; under fittings/mounts/
        >load()
        >save()
