import "semantics"

namespace eltanin
  namespace mech

    struct Element
      struct Cell
        pose: Pose
        shape: frame::shape
        role: slot::inner
        volume: inner::shape
        align: cube::Corner
      struct Plate
        pose: Pose
        shape: plate::shape
        role: slot::plate
      struct Stub
        pose: Pose
        shape: wing::shape
        role: slot::wing

    struct Blueprint
      name: string
      author: string

      cells: vector<Element::Cell>
      stubs: vector<Element::Stub>
      hull: vector<Element::Plate>
