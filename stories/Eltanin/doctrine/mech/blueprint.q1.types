import "semantics"

namespace eltanin
  namespace mech

    struct Element
      struct Cell
        pose: Pose
        shape: frame::shape
        role: slot::inner
      struct Plate
        pose: Pose
        shape: plate::shape
        role: slot::plate

    struct Blueprint
      name: string
      author: string

      cells: vector<Element::Cell>
      hull: vector<Element::Plate>
