import "semantics"

namespace eltanin
  namespace mech

    // Ship schema: cells (frame hosts) + per-cell hull membranes.
    // One cell per lattice volume. Skeleton pieces local to the cell (thinning only, no orphans).
    // C++: private/mech/blueprint.h — types from semantics.q1 / model.
    struct Blueprint
      struct Cell
        struct Frame
          corners: vector<skeleton::Corner>
          halfribs: vector<skeleton::Halfrib>
        struct Hull
          membranes: vector<skeleton::Membrane>
        pose: Pose
        shape: frame::shape
        frame: Frame
        hull: Hull
      name: string
      author: string // manufacturer
      cells: vector<Cell>
