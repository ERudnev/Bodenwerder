import "rmmr/resources/manager"
import "semantics"

namespace eltanin
  namespace mech

    // Construction schema on the Unit shelf.
    // Disk: blueprints/_unnamed.blueprint | ships/*.blueprint | prefabs/*.blueprint
    feature Blueprint of rmmr::resource::Unit
      struct Cell
        pose: Pose
        shape: frame::shape
        corners: vector<skeleton::Corner>
        halfribs: vector<skeleton::Halfrib>
        membranes: vector<skeleton::Membrane>
      one
        name: string
        author: string // manufacturer
        cells: vector<Cell>
        file: filename // kit-relative; under blueprints/
        >load()
        >save()
