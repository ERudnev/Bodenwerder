namespace eltanin
  namespace mech

    using layer as @external(eltanin::mech::layer)

    namespace orient
      using key as @external(eltanin::mech::orient::key)

    namespace cube
      using Corner as @external(eltanin::mech::cube::Corner)

    struct frame
      using shape as @external(eltanin::mech::frame::shape)

    struct plate
      using shape as @external(eltanin::mech::plate::shape)

    struct wing
      using shape as @external(eltanin::mech::wing::shape)

    struct inner
      using shape as @external(eltanin::mech::inner::shape)

    namespace slot
      using inner as @external(eltanin::mech::slot::inner)
      using plate as @external(eltanin::mech::slot::plate)
      using wing as @external(eltanin::mech::slot::wing)

    struct Pose
      pos: index3
      ori: orient::key
