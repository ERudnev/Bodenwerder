namespace eltanin
  namespace fundamental

    // Universe pulse lives in Existent Global (not per-instance Quantum).
    //   Product::onFrame wall dt → >update: now += dt * rate(warp).
    // warp 0 is pause. Systems and Celestials are separate identities.
    // Locality Thing.bornAt snapshots this now at create.
    entity Existent
      always
        >assemble() -> all
        ?rate(warp: integer) -> seconds
      all
        now: seconds
        warp: integer
        >update(dt: seconds)
