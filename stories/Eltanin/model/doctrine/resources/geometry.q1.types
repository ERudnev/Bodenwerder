import "rmmr/resources/geometry"

namespace eltanin
  namespace resources

    // Story-owned static star-cloud mesh (sphere of inward billboards around origin).
    // Fail-safe: disk stars only, one atlas sprite, additive.
    feature SkySphereGenerator of rmmr::resource::geometry::Asset
      one
        count: integer // stars to sample into the Galaxy disk
        seed: integer
        angular_diameter_deg: float // star billboard angular size
        >materialize(#system::Device) -> #rmmr::resource::geometry::Runtime?
