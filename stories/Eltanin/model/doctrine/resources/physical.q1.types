import "rmmr/math"
import "rmmr/resources/manager"

namespace eltanin
  namespace resource
    namespace physical

    using Reference as rmmr::resource::Unit::Reference

    feature Asset of rmmr::resource::Unit
      struct Face
        name: string
        indices: vector<integer>
      one
        points: vector<Pos>
        faces: vector<Face>

    feature Loader of Asset
      one
        file: filename
        >load()
