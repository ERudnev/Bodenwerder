namespace tommy

  // Scene presence. Role features (Stone/…) share this Id.
  entity GameObject
    one
      sprite: #rmmr::scene::actor::Sprite?

  // Physics payload on a GameObject (same Id).
  feature Physical of GameObject
    one
      size: float // relative scale vs role base (1 = 100%)
      mass: float // for now seeded equal to size
    all
      =resolveCollisions() // called from Game World game loop directly
