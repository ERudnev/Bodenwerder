namespace tommy

  // Scene presence. Role features (Stone/…) share this Id.
  entity GameObject
    one
      sprite: #rmmr::scene::actor::Sprite?

  // Physics payload on a GameObject (same Id).
  feature Physical of GameObject
    one
      size: float // relative scale vs role base (1 = 100%)
      mass: float // for now seeded equal to size
      hitpoints: integer // 0 = depleted
    all
      =resolveCollisions() // called from Game World game loop directly

  // Optional motion layer. Body does not own "why" vel exists — only integrates it.
  feature Inertia of Physical
    one
      vel: vec3 // current velocity; source unknown to this aspect
      saturation: float // per-step damping: vel *= (1 - saturation)
    all
      =update() // pos += vel * dt; then damp vel (dt = 1 World.step)
