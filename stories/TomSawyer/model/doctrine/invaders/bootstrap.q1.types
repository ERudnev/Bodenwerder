import "session"
import "actors"
import "combat"

namespace tommy
  namespace invaders

    // Story-facing factories: one place to stand up a playable match without scattering spawns.
    manipulation Bootstrap of Session
      >newMatch(playfield_origin: index2, playfield_size: index2)->#Session
      >installBunkers(#Session)->#
      >installPlayer(#Session)->#Player
      >installWave(#Session, wave: integer)->#Fleet
