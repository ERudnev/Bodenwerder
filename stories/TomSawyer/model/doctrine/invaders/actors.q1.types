import "../world"
import "session"
import "something"

namespace tommy
  namespace invaders

    // Cannon. Reads Window inside ~World ticks (edge/hold vs previous step), never a dt-update.
    // Appearance (pack entry + scale) is this role's always; mom Something holds the live sprite.
    feature Player of Something
      always
        move_pixels: integer = 4
        shot_cooldown_steps: integer = 25
        sprite_idle: integer = 200 // Kenney playerShip1_blue
        sprite_scale: float = 0.5
        sprite_bank: float = 180 // Node HPB.z degrees — nose toward fleet
        sprite_zet: integer = 2
      one
        session: affects<Session>
        pos: index2
        cooldown_until: integer // World.step deadline; 0 = ready
        !steer(~World) // only when change.now.step != old; sample Window keys
        !tryFire(~World) // rising edge fire → Shot(player) if cooldown elapsed
        !applyHit(~Shot) // alien bomb → destroy, notify Session
      all
        >spawn(#Session, index2)->#

    // Formation march cadence is in World.step units, not seconds.
    component Fleet of Session
      enum Dir : left, right
      always
        cell_size: index2
        descend_pixels: integer = 16
        base_march_steps: integer = 48 // shrinks as aliens die
      one
        origin: index2
        dir: Dir
        next_march: integer // World.step when next lateral step fires
        !march(~World) // when step crosses next_march
        !retuneCadence(~Alien)
        !cleared(~Alien)
      all
        >spawnWave(#Session, wave: integer)->#

    feature Alien of Something
      enum Kind : squid, crab, octopus
      always
        sprite_squid: integer = 49 // Kenney enemyBlack1
        sprite_crab: integer = 50
        sprite_octopus: integer = 51
        sprite_scale: float = 0.5
        sprite_bank: float = 180 // Node HPB.z degrees — face player
        sprite_zet: integer = 0
        ?sprite_index(Kind) -> integer
      one
        cell: index2
        kind: Kind
        points: integer
        alive: bool
        ?worldPos(#Fleet) -> index2
        !killOnHit(~Shot)

    group<Alien> of Fleet

    feature Saucer of Something
      always
        sprite_idle: integer = 0
        sprite_scale: float = 0.5
        sprite_bank: float = 0
        sprite_zet: integer = 1
      one
        session: affects<Session>
        pos: index2
        points: integer
        !drift(~World)
        !killOnHit(~Shot)
        !despawnOffscreen(~Playfield)
      all
        >maybeSpawn(#Session, ~World)->#?
