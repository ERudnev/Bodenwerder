import "../world"
import "gameObject"

namespace tommy
  namespace invaders

    // Match state. No update(dt): phase transitions wake on domain events or ~World.
    entity Session
      enum Phase : attract, playing, wave_clear, lost, won // won reserved; waves currently endless via wave_clear
      always
        start_lives: integer = 3
        wave_clear_steps: integer = 800 // pause after fleet cleared before next wave
      one
        world: anchor<World>
        phase: Phase
        score: integer
        lives: integer
        wave: integer
        wave_ready_at: integer // World.step deadline while wave_clear
        // Story wiring (raidenmamare handles — not gameplay state, but on Session quantum):
        scene: #rmmr::scene::Root
        camera: #rmmr::scene::Camera
        pack: #rmmr::resource::sprite::Pack
        material: #rmmr::resource::material::Asset
        player: #GameObject?
        !onWaveReady(~World) // wave_clear deadline → wave++ / installWave
        !attractAndRestart(~World) // Enter start / R resetMatch
      // Free helpers (session.h): notePlayerHit, noteFleetCleared, syncMenuCameraControl, sessionPlaying.
      // Hits are resolved in Shot.advanceMotion → these helpers; not Session!~Player / !~Fleet watches.

    // Play rectangle in World pixel space (Flat2d ortho units).
    component Playfield of Session
      always
        // projection defaults: origin {-800,-450}, size {1600,900}
      one
        origin: index2
        size: index2
        ?contains(index2) -> bool
      all
        >install(origin: index2, size: index2)->#
