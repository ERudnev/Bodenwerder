import "world"
import "gameObject"

namespace tommy

  // Player ship's gun — aggregate owned via Player.gun custody.
  // Dual limiter: fast mechanical cadence + heat "magazine" (°C) that cools over time.
  // Sprite spawn cannot run inside World Clock reactions (Feature Sprite needs Node
  // in the same *user* Writing patch); requestFire queues, flushPending spawns.
  entity Gun
    always
      // ~4 shots/sec at World.step = 1 ms (1000 steps/sec).
      mech_cooldown_steps: integer = 250
      temp_max_celsius: integer = 500
      // Fire only while temperature is strictly below this; shot may push at/above.
      fire_below_celsius: integer = 400
      heat_per_shot_celsius: integer = 100
      cool_celsius_per_sec: integer = 100 // full 500→0 ≈ 5 s
      muzzle_lift: float = 40.0 // along nose from ship sprite pos
    one
      world: affects<World> // !cool inbound index (World delta → Gun)
      mech_ready_at: integer // World.step when mechanical gate opens; 0 = ready
      temperature_celsius: integer // clamped [0, temp_max]
      cool_step_carry: integer // residual steps toward next °C of cooling
      pending_shots: integer // queued by requestFire; drained by flushPending
      owner: #GameObject? // ship body for muzzle / sprite pack at flush
      !cool(~World) // step delta → shed heat toward 0
    all
      >requestFire(#GameObject) // mech+heat gates; queue one bolt (no sprite yet)
      =flushPending() // Writing: spawn queued Shot sprites (call from UI tick)
