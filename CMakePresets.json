{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-clang-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
                "CMAKE_RC_COMPILER": "C:/Program Files/LLVM/bin/llvm-rc.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-clang-debug",
            "displayName": "Ninja + LLVM (Debug)",
            "inherits": "ninja-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-clang-release",
            "displayName": "Ninja + LLVM (Release)",
            "inherits": "ninja-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja-msvc-base",
            "hidden": true,
            "generator": "Ninja",
            "description": "Run from a Developer Command Prompt (vcvars64.bat) so cl.exe, INCLUDE and LIB are set.",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "Ninja + MSVC (Release)",
            "inherits": "ninja-msvc-base",
            "binaryDir": "${sourceDir}/build/msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "Ninja + MSVC (Debug)",
            "inherits": "ninja-msvc-base",
            "binaryDir": "${sourceDir}/build/msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Ninja + clang-cl (Release)",
            "description": "clang-cl from PATH (scoop llvm), run from a Developer Command Prompt for rc.exe and the SDK.",
            "inherits": "ninja-msvc-base",
            "binaryDir": "${sourceDir}/build/clang",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-asan",
            "displayName": "Ninja + MSVC (Debug, ASan)",
            "description": "AddressSanitizer on project targets (cmake/Sanitizers.cmake). cl has no UBSan; see clang-ubsan. Run from a Developer Command Prompt.",
            "inherits": "ninja-msvc-base",
            "binaryDir": "${sourceDir}/build/msvc-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAQL_SANITIZE": "address"
            }
        },
        {
            "name": "clang-ubsan",
            "displayName": "Ninja + clang-cl (Debug, UBSan)",
            "description": "UndefinedBehaviorSanitizer on project targets (cmake/Sanitizers.cmake), static CRT. clang-cl from PATH, run from a Developer Command Prompt. clang-cl ASan is refused there: it breaks C++ exception handling.",
            "inherits": "ninja-msvc-base",
            "binaryDir": "${sourceDir}/build/clang-ubsan",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_BUILD_TYPE": "Debug",
                "DAQL_SANITIZE": "undefined"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "ninja-clang-debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "ninja-clang-release"
        },
        {
            "name": "ReleaseKinda",
            "description": "",
            "displayName": "",
            "configurePreset": "ninja-clang-release"
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "configurePreset": "msvc-release"
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "clang-release",
            "displayName": "clang-cl Release",
            "configurePreset": "clang-release"
        },
        {
            "name": "msvc-asan",
            "displayName": "MSVC ASan: test suite",
            "description": "Builds the test executables only. Run each one afterwards; ASan aborts on the first error.",
            "configurePreset": "msvc-asan",
            "targets": ["base_tests", "fQSM_tests", "Eltanin_horn_tests"]
        },
        {
            "name": "clang-ubsan",
            "displayName": "clang-cl UBSan: test suite",
            "description": "Builds the test executables only. Run each one afterwards, with UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 to fail on the first UBSan report.",
            "configurePreset": "clang-ubsan",
            "targets": ["base_tests", "fQSM_tests", "Eltanin_horn_tests"]
        }
    ]
}