import "../world"
import "session"
import "gameObject"

namespace si01
  namespace invaders

    // Bolt: motion + presence. Who fires lives on Gun (player) / Volley (alien) — not here.
    feature Shot of GameObject
      enum Side : player, alien
      always
        max_hitpoints: integer = 1
        player_speed: integer = 1 // px per World.step
        alien_speed: integer = 1 // px per alien_speed_period World.steps
        alien_speed_period: integer = 2
        sprite_player: integer = 105 // Kenney laserBlue01
        sprite_alien: integer = 137 // Kenney laserRed01
        sprite_scale: float = 0.5
        sprite_bank: float = 0
        sprite_zet: integer = 1
        hit_half: index2 // projection {3, 10}
        ?sprite_index(Side) -> integer
      one
        session: affects<Session>
        pos: index2
        side: Side
        motion_carry: integer // alien half-speed remainder
        !advance(~World)->>advanceMotion() // move, cull off-field, resolveHit
      // resolveHit (Internals): alien shot → Player hull; player shot → Alien hull;
      // on deplete → Session.notePlayerHit / noteFleetCleared (free helpers).

    group<Shot> of Session
