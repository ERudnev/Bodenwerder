import "system/core"

namespace rmmr
  namespace resource

  // persistent layer
    component Manager of system::Core
      one
        location: filepath
        >load()
      all
        ?singleton()->#?
        // kit-relative filename → absolute under Manager.location [/ library]
        ?resolve(one<Unit>, filename)->filepath

    // persistent thing
    entity Unit
      struct Name
        library: string
        own: string
        ?text()->string
        >from(string, string) -> Name
      struct Reference
        id: #
        backup: Name
      one
        name: Name
        ?remember()->Reference

    group<Unit> of Manager
