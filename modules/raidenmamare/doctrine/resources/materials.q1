import "semantics"
import "resources/manager"
import "resources/shaders"

namespace rmmr
  namespace resource
    namespace material

    using Reference as resource::Unit::Reference

    // Material = pass techniques (shader + uniform slots + blend). Sampler values are on the draw.
    // Instance = material + sampler params; albedoMap value = texpack layer filename.
    struct Instance
      material: #Asset
      textures: umap<string, string>

    entity Runtime
      using Locations as @external(rmmr::material::Semantics::RuntimeMapping)
      struct Technique
        shader: #shader::Runtime
        locations: Locations
        bindings: vector<Uniform::Binding>
        glowSpread: bool
      one
        techniques: umap<renderer::Pass, Technique>
        nearest: bool
        blend: renderer::BlendMode
        ?apply(#system::Device, renderer::Pass)

    feature Asset of resource::Unit
      struct Technique
        program: shader::Reference
        uniforms: Uniform::Palette
        glowSpread: bool
      one
        techniques: umap<renderer::Pass, Technique>
        nearest: bool
        blend: renderer::BlendMode
        >materialize(#system::Device) -> #Runtime
