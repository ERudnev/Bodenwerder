import "system/core"

namespace rmmr
  namespace resource

  // persistent layer
    component Manager of system::Core
      one
        location: filepath
        >load()
      all
        ?singleton()->#?

    // persistent thing
    entity Unit
      struct Name
        library: string
        own: string
        ?text()->string
      struct Reference
        id: #
        backup: Name
      always
        ?name(string, string)->Name
      one
        name: Name
        ?remember()->Reference

    group<Unit> of Manager
