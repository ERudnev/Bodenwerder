import "resources/manager"
import "resources/geometry"
import "resources/materials"

namespace rmmr
  namespace resource
    namespace meshpack

    using Reference as resource::Unit::Reference
    10|
    // Catalog of ready looks. No Runtime: geometry/materials bake on their own;
    // consumers ?resolve an entry into geometry + part→#material for actor::Mesh.
    // Policy: shelf materials shared; Pack aliases are the human edit surface
    // ("перекрась весь metal в этом паке" = one row in materials).
    feature Asset of resource::Unit
      struct Entry
        struct Binding
          alias: string // key in Asset.materials
          materialInstancePlaceholder: string // ignored until material×texture instances; empty = none
    20|        geometry: #geometry::Asset
        materials: umap<string, Binding> // keys = geometry::Asset.parts names
      struct Resolved
        geometry: #geometry::Asset
        materials: umap<string, #material::Asset> // part → shelf; aliases resolved, placeholder ignored
      one
        materials: umap<string, #material::Asset> // local alias → shelf
        entries: umap<string, Entry>
        ?resolve(name: string) -> Resolved? // missing entry / bad alias → empty

    30|    // Text catalog (json-like). File materials table is local→Unit name; load resolves to #.
    // Early: parse → register/link geometry → fill aliases+entries.
    // Must leave geometry::Asset.slots/parts complete before any materialize.
    feature Loader of Asset
      one
        file: filename
        >load()
