import "resources/manager"
import "resources/geometry"
import "resources/materials"

namespace rmmr
  namespace resource
    namespace meshpack

    using Reference as resource::Unit::Reference
    // Catalog of ready looks. No Runtime: geometry/materials bake on their own;
    // consumers ?resolve an entry into geometry + part→#material for actor::Mesh.
    // Runtime binding: geometry part name → #material. File formats differ per loader.
    feature Asset of resource::Unit
      struct Entry
        geometry: #geometry::Asset
        materials: umap<string, #material::Asset> // keys = geometry::Asset.parts names
      struct Resolved
        geometry: #geometry::Asset
        materials: umap<string, #material::Asset> // part → shelf
      one
        entries: umap<string, Entry>
        ?resolve(name: string) -> Resolved? // missing entry → empty

    // Text catalog (*.obj.meshpack): entries → separate OBJ files + part→Unit.own.
    feature LoaderObjs of Asset
      one
        file: filename
        >load()

    // *.lwo.meshpack — one LWO + table file material name → Unit::Name::text ("lib::own").
    // meshes → entries; missing table entry or shelf material → refuse.
    feature LoaderLwo of Asset
      one
        file: filename
        >load()
