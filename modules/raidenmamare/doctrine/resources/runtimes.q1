import "resources/manager"
import "resources/meshpack"
import "resources/overlays"
import "resources/texpack"
import "resources/texture3array"

namespace rmmr
  namespace resource

    // Core-level interface:
    component Assets of Manager
      one
        >add_texture_loader(Unit::Name, texture::Loader)->#texture::Asset
        >add_texture_generator(Unit::Name, texture::Generator)->#texture::Asset
        >add_texpack_catalog(Unit::Name, texpack::LoaderCatalog, layerSize: index2, capacity: integer)->#texpack::Pack
        >add_shader_loader(Unit::Name, shader::Loader)->#shader::Asset
        >add_material(Unit::Name, material::Asset)->#material::Asset
        >add_overlay(Unit::Name, overlay::Asset)->#overlay::Asset
        >add_shadow_allocator(Unit::Name, shadow::Allocator)->#shadow::Asset
        >add_geometry_loader(Unit::Name, geometry::Loader)->#geometry::Asset
        >add_geometry_generator(Unit::Name, geometry::Generator)->#geometry::Asset
        >add_sprites_kenney(Unit::Name, sprite::LoaderKenney)->#sprite::Pack
        >add_meshpack_objs_loader(Unit::Name, meshpack::LoaderObjs)->#meshpack::Asset
        >add_meshpack_lwo_loader(Unit::Name, meshpack::LoaderLwo)->#meshpack::Asset
        ?find<R as feature of Unit>(Unit::Name)-> #R?
      all
        singleton: #
        ?singleton()-> #
        >extend(path: filepath)

    // TODO: mve to Interface file (dependencies, must be invisible to major types)
    component DeviceRuntimes of system::Device
      one
        assets: #Assets

    group<texture::Runtime> of resource::DeviceRuntimes
    group<texpack::Runtime> of resource::DeviceRuntimes
    group<texture3array::Runtime> of resource::DeviceRuntimes
    group<shader::Runtime> of resource::DeviceRuntimes
    group<material::Runtime> of resource::DeviceRuntimes
    group<overlay::Runtime> of resource::DeviceRuntimes
    group<shadow::Runtime> of resource::DeviceRuntimes
    group<geometry::Runtime> of resource::DeviceRuntimes
    group<sprite::Runtime> of resource::DeviceRuntimes

    component Runtimes of Device
      one
        textures_id_mapping: umap<#texture::Asset, #texture::Runtime> // allows finding Asset presentation of this Device
        texpacks_id_mapping: umap<#texpack::Pack, #texpack::Runtime>
        texture3arrays_id_mapping: umap<#texture3array::Asset, #texture3array::Runtime>
        shaders_id_mapping: umap<#shader::Asset, #shader::Runtime>
        materials_id_mapping: umap<#material::Asset, #material::Runtime>
        overlays_id_mapping: umap<#overlay::Asset, #overlay::Runtime>
        shadows_id_mapping: umap<#shadow::Asset, #shadow::Runtime>
        geometries_id_mapping: umap<#geometry::Asset, #geometry::Runtime>
        sprites_id_mapping: umap<#sprite::Pack, #sprite::Runtime>
        >install(#Device) // cache is zero by default
        >materialize() // one-shot: family Assets → find Kind by id → materialize+bind
        !maintain_all_mappings(~Assets)
