import "math"
import "renderer/gl"
import "resources/manager"

namespace rmmr
  namespace resource
    namespace geometry

    using Reference as resource::Unit::Reference

    entity Runtime
      one
        device: #system::Device
        vao: renderer::VertexArray
        vbo: renderer::VertexBuffer
        ebo: renderer::ElementBuffer
        vertex_count: renderer::Count
        index_count: renderer::Count

    // Persistent mesh recipe. Scene may hold #geometry::Asset — never Runtime.
    // Import: home (LCA of mesh nodes) baked into CPU verts at materialize — not stored.
    // slots = leaf empties (Assimp/FBX nulls), transform relative to that home (= vertex space).
    // OBJ authored in canonical space → home≡E, slots usually empty.
    feature Asset of resource::Unit
      struct Mount
        name: string
        transform: mat4
      struct Part
        startIndex: renderer::Count
        countIndex: renderer::Count
      one
        slots: vector<Mount>
        parts: umap<string, Part>

    feature Loader of Asset
      one
        file: filename
        >materialize(#system::Device) -> #Runtime?

    feature Generator of Asset
      enum Type : triangle, kube, bagel, gridPlane, unitQuad, sphere, diamond
      one
        type: Type
        >materialize(#system::Device) -> #Runtime?
