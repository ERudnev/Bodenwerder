import "math"
import "renderer/gl"
import "resources/manager"

namespace rmmr
  namespace resource
    namespace geometry

    using Reference as resource::Unit::Reference
    using EntryId as renderer::Integer32
    using SurfaceId as renderer::Integer32

    entity Runtime
      one
        device: #system::Device
        vao: renderer::VertexArray
        vbo: renderer::VertexBuffer
        ebo: renderer::ElementBuffer
        primitiveSurfaces: renderer::StorageBuffer
        vertex_count: renderer::Count
        index_count: renderer::Count

    // One Asset/Runtime pool owns one source file and its common VAO/VBO/EBO/surface SSBO.
    // Names are catalog-only; scene/render data carries numeric EntryId/SurfaceId.
    feature Asset of resource::Unit
      struct Range
        first: renderer::Count
        count: renderer::Count
      struct Mount
        name: string
        transform: mat4
      struct Entry
        vertices: Range
        indices: Range
        surfaces: Range
        mounts: Range
        origin: vec3
      struct Surface
        indices: Range
      one
        entries: vector<Entry>
        surfaces: vector<Surface>
        mounts: vector<Mount>
        entryCatalog: umap<string, EntryId>
        surfaceCatalogs: vector<umap<string, SurfaceId>>

    feature Loader of Asset
      one
        file: filename
        >materialize(#system::Device) -> #Runtime?

    feature Generator of Asset
      enum Type : triangle, kube, bagel, gridPlane, unitQuad, sphere, diamond
      one
        type: Type
        >materialize(#system::Device) -> #Runtime?
