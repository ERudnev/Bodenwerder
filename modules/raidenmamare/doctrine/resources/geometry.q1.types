import "math"
import "renderer/gl"
import "resources/manager"

namespace rmmr
  namespace resource
    namespace geometry

    using Reference as resource::Unit::Reference

    entity Runtime
      one
        device: #system::Device
        vao: renderer::VertexArray
        vbo: renderer::VertexBuffer
        ebo: renderer::ElementBuffer
        vertex_count: renderer::Count
        index_count: renderer::Count

    // Persistent mesh recipe. Scene may hold #geometry::Asset — never Runtime.
    feature Asset of resource::Unit
      struct Part
        startIndex: renderer::Count
        countIndex: renderer::Count
      one
        slots: vector<Pos> // i insist on exactly this kind of slots
        parts: umap<string, Part>

    feature Loader of Asset
      one
        file: filename
        >materialize(#system::Device) -> #Runtime?

    feature Generator of Asset
      enum Type : triangle, kube, windowedKube, bagel, gridPlane, unitQuad, sphere, diamond
      one
        type: Type
        >materialize(#system::Device) -> #Runtime?
