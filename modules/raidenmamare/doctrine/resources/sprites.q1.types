import "renderer/gl"
import "resources/manager"
import "resources/textures"

namespace rmmr
  namespace resource
    namespace sprite

    using Reference as resource::Unit::Reference

    // GPU face for sprite atlases: texture + atlas entry table as SSBO.
    entity Runtime
      one
        device: #system::Device
        texture: #texture::Runtime
        entries_buffer: renderer::VertexBuffer
        count: integer

    // Catalog entity is Pack — a "sprite" is an entry index, not an aspect.
    // Entry coords are absolute atlas texels (Photoshop-friendly): min / max / pivot.
    feature Pack of resource::Unit
      struct Entry
        min: index2
        max: index2
        pivot: index2
      one
        texture: texture::Reference
        entries: vector<Entry>
        >materialize(#system::Device) -> #Runtime?

    // Kenney TextureAtlas XML (x,y,width,height) → absolute min/max/pivot entries.
    feature LoaderKenney of Pack
      one
        image: filename
        descriptor: filename
        >load() // parse descriptor into Pack.entries
