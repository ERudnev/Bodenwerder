import "../system/core"
import "../system/window"
import "../scene/camera"

namespace rmmr
  namespace controller

    // Ortho/2D pan control for an existing scene::Camera.
    // Time from system::Clock deltas (change.old / change.now); input from Window.
    attribute Camera2d of scene::Camera
      one
        >create()-> #
      all
        !update(~system::Clock) // RMB drag + arrows on XY
