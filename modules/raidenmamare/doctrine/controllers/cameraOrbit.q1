import "system/core"
import "system/viewInput"
import "scene/camera"
import "math"

namespace rmmr
  namespace controller

    // Orbit: looks at pivot; RMB turns HPB around it; distance along view.
    attribute CameraOrbit of scene::Camera
      one
        pivot: Pos
        hpb: HPB // bank kept 0
        distance: float
        input: #system::ViewInput
        >create(input: #system::ViewInput, pivot: Pos, distance: float)-> #
      all
        =tick(dt: seconds) // RMB orbit; wheel zoom; arrows pan pivot (speed follows distance)
