import "system/core"
import "system/viewInput"
import "scene/camera"

namespace rmmr
  namespace controller

    // Classic 3D fly/look control for an existing scene::Camera.
    // Driven once per frame by the engine input phase (=tick); input from its ViewInput mail.
    attribute Camera3d of scene::Camera
      one
        moveScale: float
        input: #system::ViewInput
        >create(input: #system::ViewInput)-> #
      all
        =tick(dt: seconds) // RMB look in camera space; WASD+RF move; QE roll around view; Shift ×10 move only
