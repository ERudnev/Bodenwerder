import "system/core"
import "system/window"
import "scene/camera"

namespace rmmr
  namespace controller

    // Classic 3D fly/look control for an existing scene::Camera.
    // Time from system::Clock deltas (change.old / change.now); input from Window.
    attribute Camera3d of scene::Camera
      one
        >create()-> #
      all
        !update(~system::Clock) // RMB look in camera space; WASD+RF move; QE roll around view; Shift ×10
