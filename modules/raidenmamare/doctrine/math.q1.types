namespace rmmr

  using Pos as vec3
  using HPB as vec3
  using RGB as vec3
  using UV as vec2

  struct Locator
    pos: Pos
    euler: HPB

  struct Pose
    position: Pos
    rotation: quat
    ?hpb() -> HPB // heading/pitch/bank (degrees)
    =hpb(HPB)
    ?near(Pose) -> bool
    >from(Locator) -> Pose
