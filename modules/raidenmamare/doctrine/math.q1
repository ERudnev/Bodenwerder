namespace rmmr

  using Pos as vec3
  using HPB as vec3
  using RGB as vec3
  using UV as vec2

  struct Pose
    position: Pos
    rotation: quat
    ?hpb() -> HPB // degrees: +heading nose right, +pitch nose up, +bank clockwise along nose
    =hpb(HPB)
    ?near(Pose) -> bool
    >from(Pos, HPB) -> Pose
