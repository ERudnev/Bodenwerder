import "system/core"

namespace rmmr
  namespace resource

    struct Uniform
      using Id as @external(rmmr::material::Semantics::PersistentId)
      using Type as @external(rmmr::material::Semantics::Type)
      using Location as @external(rmmr::material::Semantics::RenderId)
      using Palette as vector<Id>
      struct Binding
        id: Id
        type: Type
        location: Location

  namespace renderer

    using Pass as @external(rmmr::renderer::Pass)
    using Passes as @external(rmmr::renderer::Passes)
    using BlendMode as @external(rmmr::renderer::BlendMode)
    using ToggleMode as @external(rmmr::renderer::ToggleMode)
    using DepthCompare as @external(rmmr::renderer::DepthCompare)
    using LightingMode as @external(rmmr::renderer::LightingMode)
    using RenderState as @external(rmmr::renderer::RenderState)
