import "../math"
import "../renderer/types"
import "../system/core"
import "actors/simple"
import "actors/sprite"
import "camera"
import "gizmos"
import "light"
import "node"

namespace rmmr
  namespace scene

    entity Root
      one
        ambient: RGB
        ambient_intensity: float

    group<Node> of Root
    group<Camera> of Root
    group<Light> of Root

    manipulation Interface of Root
      >createScene()->#
      >createCamera(#, Locator, fov_x: float)->#Camera
      >createLight(#, Locator, one<Light>)->#Light
      >createSimpleActor(#, Locator, one<actor::Simple>)->#actor::Simple
      >createGrid(#, Locator, one<Grid>)->#Grid
      ?render(#, #system::Device, >where: renderer::CommandBuffer)

    // Ortho/2D layer on a scene root — sprite actors created here.
    // Camera looks along -Z; ortho_size taken from Flat2d.size.
    feature Flat2d of Root
      one
        size: index2
        >createCamera(Locator)->#Camera
        >createSpriteActor(Locator, one<actor::Sprite>)->#actor::Sprite
