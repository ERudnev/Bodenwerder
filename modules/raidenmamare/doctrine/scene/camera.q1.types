import "../math"
import "node"

namespace rmmr
  namespace scene

    // Camera settings bound to a scene node.
    // Create APIs do not pass this Quantum: Root/Flat2d helpers fill it.
    feature Camera of Node
      enum Mode : perspective, orthographic, parallel
      one
        mode: Mode
        z_near: float
        z_far: float
        fov_y: float          // perspective
        ortho_size: index2    // orthographic full extent (world/logical units)
        ?projection(aspect_ratio: float) -> mat4
        ?view() -> mat4
        ?view_projection(aspect_ratio: float) -> mat4
      all
        >create(Locator, fov_y: float) -> #
