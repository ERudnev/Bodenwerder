import "math"
import "renderer/types"
import "system/core"
import "resources/meshpack"
import "scene/actors/mesh"
import "scene/actors/sprite"
import "scene/camera"
import "scene/gizmos"
import "scene/light"
import "scene/node"

namespace rmmr
  namespace scene

    entity Root
      struct Bloom
        radius: float
        intensity: float
      one
        ambient: RGB
        ambient_intensity: float
        bloom: Bloom

    group<Node> of Root
    group<Camera> of Root
    group<Light> of Root

    manipulation Interface of Root
      using Meshes as resource::meshpack::Asset
      >createScene()->#
      >createCamera(#, Pose, fov_x: float)->#Camera
      >createLight(#, Pose, one<Light>)->#Light
      >createMeshActor(#, Pose, one<actor::Mesh>, one<actor::MeshState>)->#actor::Mesh
      >createMeshActor(#, Pose, Meshes::Resolved)->#actor::Mesh
      >createMeshActor(#, Pose, Meshes::Resolved, one<actor::MeshState>)->#actor::Mesh
      >createMeshActor(#, Pose, #Meshes, entry: string)->#actor::Mesh
      >createMeshActor(#, Pose, #Meshes, entry: string, one<actor::MeshState>)->#actor::Mesh
      >createGrid(#, #system::Device, Pose, one<Grid>)->#Grid
      ?render(#, #system::Device, >where: renderer::CommandBuffer)

    // Ortho/2D layer on a scene root — sprite actors created here.
    // Camera looks along -Z; ortho_size taken from Flat2d.size.
    feature Flat2d of Root
      one
        size: index2
        device: #system::Device
        >createCamera(Pose)->#Camera
        >createSpriteActor(Pose, one<actor::Sprite>)->#actor::Sprite
