import "resources/geometry"
import "resources/materials"
import "resources/texpack"
import "renderer/types"
import "system/core"
import "math"
import "scene/node"

namespace rmmr
  namespace scene
    namespace actor

      feature Simple of Node
        one
          geometry: #resource::geometry::Asset
          material: #resource::material::Asset
          texpack: #resource::texpack::Pack?
          albedoLayer: string?
          albedo: RGB
          scale: vec3
          ?submit(#system::Device, >where: renderer::CommandBuffer)
        all
          >create(Pos, HPB, geometry: #resource::geometry::Asset, material: #resource::material::Asset, texpack: #resource::texpack::Pack?, albedoLayer: string?, albedo: RGB) -> #
