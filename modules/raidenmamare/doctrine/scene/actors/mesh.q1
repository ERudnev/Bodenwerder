import "resources/meshpack"
import "resources/texpack"
import "resources/texture3array"
import "resources/materials"
import "resources/sprites"
import "renderer/types"
import "system/core"
import "math"
import "scene/node"

namespace rmmr
  namespace scene
    namespace actor

      feature Mesh of Node
        struct Occurrence
          entry: resource::meshpack::Asset::Resolved
          pose: renderer::DiscretePose
        struct Bucket
          geometry: #resource::geometry::Runtime
          material: #resource::material::Runtime
          texpack: #resource::texpack::Runtime?
          texture3array: #resource::texture3array::Runtime?
          indirect: renderer::IndirectBuffer
          drawCount: renderer::Count
          metadataByteOffset: renderer::IntPtr
          metadataByteSize: renderer::SizePtr
        one
          device: #system::Device
          actorState: renderer::StorageBuffer
          poses: renderer::StorageBuffer
          cohesions: renderer::StorageBuffer
          heats: renderer::StorageBuffer
          instanceCount: integer
          wreckedLayer: integer
          maskLayer: integer
          drawMetadata: renderer::StorageBuffer
          surfacePalette: renderer::StorageBuffer
          sprite: #resource::sprite::Runtime?
          spriteIndex: integer
          buckets: vector<Bucket>
          ?submit(#system::Device, >where: renderer::CommandBuffer)
          ?writeCohesions(vector<float>)
          ?writeHeats(vector<float>)
          ?replace(one)
        all
          ?compose(vector<Occurrence>)->one?
          ?compose(resource::meshpack::Asset::Resolved)->one?
          ?composeOne(#resource::geometry::Asset, #resource::material::Asset)->one?
          ?composeOne(#resource::geometry::Asset, #resource::material::Asset, #resource::texture3array::Asset)->one?

      feature MeshState of Mesh
        one
          albedo: RGB
          scale: vec3
          latticeStep: float
          patternScale: float
          opacity: float
          heat: vec2
        all
          ?defaults()->one
          ?defaults(RGB, opacity: float)->one
          ?defaults(RGB, opacity: float, scale: vec3)->one

      feature Identified of Mesh
        one
          scenicAlias: renderer::Integer32
          selected: bool
        all
          lastGeneratedId: integer
          material: #resource::material::Asset?
          ?lookup(renderer::Integer32)->#?
          >applySelection(vector<renderer::Integer32>)
          >extend(#Mesh)
          ?submit(#system::Device, >where: renderer::CommandBuffer)
