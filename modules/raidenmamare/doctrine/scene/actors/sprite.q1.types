import "../../resources/geometry"
import "../../resources/materials"
import "../../resources/sprites"
import "../../renderer/types"
import "../../system/core"
import "../../math"
import "../node"

namespace rmmr
  namespace scene
    namespace actor

    // Sprite draw in scene space. Rotation from Node; local scale here.
    // tint: relative additive RGB (zero = neutral). vec3 allows negatives.
    // opacity: multiply into fragment alpha (1 = fully opaque).
    feature Sprite of Node
      one
        material: #resource::material::Asset
        tint: RGB
        opacity: float
        scale: vec3
        pack: #resource::sprite::Pack
        index: integer
        ?submit(#system::Device, >where: renderer::CommandBuffer)
      all
        geometry: #resource::geometry::Asset? // shared unit quad; set before spawn/submit
        >create(Pos, HPB, scale: vec3, material: #resource::material::Asset, tint: RGB, pack: #resource::sprite::Pack, index: integer) -> #
