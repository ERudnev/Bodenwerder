import "resources/geometry"
import "resources/materials"
import "resources/texpack"
import "renderer/types"
import "system/core"
import "math"
import "scene/node"

namespace rmmr
  namespace scene
    namespace actor

      feature Mesh of Node
        one
          geometry: #resource::geometry::Asset
          parts: umap<string, resource::material::Instance>
          texpack: #resource::texpack::Pack?
          albedo: RGB
          scale: vec3
          opacity: float
          visible: bool
          >setVisible(bool)
          ?submit(#system::Device, >where: renderer::CommandBuffer)
        all
          >create(Pos, HPB, geometry: #resource::geometry::Asset, parts: umap<string, resource::material::Instance>, texpack: #resource::texpack::Pack?, albedo: RGB) -> #

      feature Identified of Mesh
        one
          scenicAlias: renderer::Integer32
          selected: bool
        all
          lastGeneratedId: integer
          material: #resource::material::Asset?
          ?lookup(renderer::Integer32)->#?
          >applySelection(vector<renderer::Integer32>)
          >extend(#Mesh)
          ?submit(#system::Device, >where: renderer::CommandBuffer)
