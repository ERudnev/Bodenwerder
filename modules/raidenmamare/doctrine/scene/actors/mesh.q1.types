import "resources/geometry"
import "resources/materials"
import "renderer/types"
import "system/core"
import "math"
import "scene/node"

namespace rmmr
  namespace scene
    namespace actor

      // One geometry Asset; materials keyed by geometry::Asset.parts names.
      feature Mesh of Node
        one
          geometry: #resource::geometry::Asset
          materials: umap<string, #resource::material::Asset>
          albedo: RGB
          scale: vec3 // local; Node has no scale
          opacity: float // → u_opacity (lit_transparent etc.)
          visible: bool // submit skips when false
          >setVisible(bool)
          ?submit(#system::Device, >where: renderer::CommandBuffer)
        all
          >create(Pos, HPB, geometry: #resource::geometry::Asset, materials: umap<string, #resource::material::Asset>, albedo: RGB) -> #

      feature Identified of Mesh
        one
          scenicAlias: renderer::Integer32
          selected: bool // → Pass::identitySelected as well as Pass::identity
        all
          lastGeneratedId: integer // starts from zero on startup, first generated will be 1
          material: #resource::material::Asset? // shared identity pick material; bind once at asset bootstrap
          // do not store mapping Integer32 -> # — find() each time (worst case once per frame)
          ?lookup(renderer::Integer32)->#?
          >applySelection(vector<renderer::Integer32>) // clear all, set selected for listed aliases
          >extend(#Mesh)
          ?submit(#system::Device, >where: renderer::CommandBuffer)
