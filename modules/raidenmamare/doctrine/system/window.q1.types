import "core"

namespace rmmr
  namespace system

    // Drawable surface bound to Device (GLFW window + OpenGL context).
    // Resize: poll framebuffer each frame — no GLFW resize callback.
    // Time lives on system::Clock; Window only snapshots input.
    component Window of Device
    enum Presentation : windowed, maximized
    struct InputState
      keys: vector<bool>
      mouse: index2
    one
      title: string
      InputState previous
      InputState current
      >create(title: string, requested_size: index2, presentation: Presentation)->#
      ?framebufferSize() -> index2   // live drawable extent (glfwGetFramebufferSize)
      ?present()
      ?mouseShift() -> index2
      =onFrameAdvanced()             // input snapshot only
