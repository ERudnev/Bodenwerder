import "math"
import "renderer/gl"
import "semantics"
import "resources/geometry"
import "resources/materials"
import "resources/shaders"
import "resources/sprites"
import "resources/texpack"
import "resources/texture3array"

namespace rmmr
  namespace renderer

    struct RenderState
      blend: BlendMode

    // Immutable actor-local lattice transform. The world transform remains on the actor.
    struct DiscretePose
      pos: index3
      ori: Signed32
      >identity() -> DiscretePose

    // Binary-compatible with OpenGL DrawElementsIndirectCommand.
    struct DrawElementsIndirect
      count: Integer32
      instanceCount: Integer32
      firstIndex: Integer32
      baseVertex: Signed32
      baseInstance: Integer32

    // gl_DrawID selects metadata; gl_BaseInstance selects DiscretePose.
    // Surface layer = surfacePalette[surfaceBase + primitiveSurfaces[primitiveBase + gl_PrimitiveID]].
    struct DrawMetadata
      primitiveBase: Integer32
      surfaceBase: Integer32

    // Mesh shader SSBO bindings:
    // 7 ActorState, 8 DiscretePose[], 9 DrawMetadata[], 10 uint surfacePalette[], 11 uint primitiveSurfaces[].

    // std430-compatible actor data. albedoOpacity.w is opacity;
    // latticePattern is latticeStep/patternScale. heat.xy is kelvin/erosion.
    struct ActorState
      model: mat4
      albedoOpacity: vec4
      latticePattern: vec2
      scenicAlias: Integer32
      spriteIndex: Integer32
      heat: vec4

    // std140-compatible frame/pass data. Vec4 tails carry meaningful values.
    struct PassState
      view: mat4
      projection: mat4
      lightSpace: mat4
      ambientColorIntensity: vec4
      primaryLightPositionIntensity: vec4
      primaryLightColorRange: vec4
      shutter: vec4 // x = seconds; yzw unused

    struct GpuBatch
      geometry: #resource::geometry::Runtime
      material: #resource::material::Runtime
      shader: #resource::shader::Runtime
      texpack: #resource::texpack::Runtime?
      texture3array: #resource::texture3array::Runtime?
      sprite: #resource::sprite::Runtime?
      actorState: StorageBuffer
      poses: StorageBuffer
      drawMetadata: StorageBuffer
      surfacePalette: StorageBuffer
      metadataByteOffset: IntPtr
      metadataByteSize: SizePtr
      indirect: IndirectBuffer
      drawCount: Count
      renderState: RenderState

    using CommandBuffer as @external(rmmr::renderer::CommandBuffer)
