import "math"
import "renderer/gl"
import "semantics"
import "resources/geometry"
import "resources/materials"
import "resources/shaders"
import "resources/sprites"

namespace rmmr
  namespace renderer

    struct RenderState
      blend: BlendMode

    struct InstanceSource
      buffer: VertexBuffer
      byte_offset: IntPtr

    struct IndexRange
      start: Count
      count: Count

    struct Command
      model: mat4
      geometry: #resource::geometry::Runtime
      material: #resource::material::Runtime
      shader: #resource::shader::Runtime
      sprite: #resource::sprite::Runtime?
      sprite_index: integer
      albedo: RGB
      opacity: float
      instance_data: InstanceSource
      instance_count: Count
      render_state: RenderState
      indices: IndexRange? // empty = whole mesh; else glDrawElements range (index units)

    using CommandBuffer as @external(rmmr::renderer::CommandBuffer)
