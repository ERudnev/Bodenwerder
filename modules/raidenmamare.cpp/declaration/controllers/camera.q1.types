import "../system/window"
import "../scene/camera"

namespace rmmr
  namespace controller

    // Optional input controller for an existing scene::Camera feature.
    // Mode picks the control scheme; demos attach explicitly.
    attribute Camera of scene::Camera
      enum Mode : classic, pan
      one
        mode: Mode
        >create(Mode)-> #
        !update() // classic: RMB look + arrows; pan: XY drag/arrows
