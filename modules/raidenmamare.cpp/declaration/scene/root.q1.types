import "../math"
import "../renderer/types"
import "../system/core"
import "actors/simple"
import "actors/sprite"
import "camera"
import "gizmos"
import "light"
import "node"

namespace rmmr
  namespace scene

    entity Root
      one
        ambient: RGB
        ambient_intensity: float

    group<Node> of Root
    group<Camera> of Root
    group<Light> of Root

    manipulation Interface of Root
      >createScene()->#
      >createCamera(#, Locator, one<Camera>)->#Camera
      >createLight(#, Locator, one<Light>)->#Light
      >createSimpleActor(#, Locator, one<actor::Simple>)->#actor::Simple
      >createGrid(#, Locator, one<Grid>)->#Grid
      ?render(#, #system::Device, >where: renderer::CommandBuffer)

    feature Flat2d of Root
      one
        size: index2
        >createSpriteActor()->#actor::Sprite
