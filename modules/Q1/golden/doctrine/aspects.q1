// Q1 Codogen Etalon
//@ dont inject this comments to mirrored files

namespace Q1_fQSM
  namespace Etalon

    //@ in is not forward, it is mature Aspect definition (just minimal Aspect)
    entity Trivia

    entity Origin
      always
        >assemble() -> all
      all
        trivia: #Trivia

    entity SampleEntity
      always //@ treat as public static const (constexpr) in the Aspect root
        max_elements: integer = 2000 // static constants values must be always defined
        absolute_min: integer = -1000
        absolute_max: integer = 1000
        ?from_float(float) -> integer //@ always-level functions have no additional parameters
      one //@ item-level data and oprtaions
        data_field: integer
        ?const_element_method() -> string
        =nonconst_element_method()
        !min_value(=one) // quantum constraint on change
        !max_value(=one)
      all
        common_data: integer
        >from_float(value_approximate: float) -> #
        ?find_first(integer) -> #?
        ?const_fieldwide_method() -> integer // just sum of all values
        =nonconst_fieldwide_method() // removes one item with minimal value
        !some_logic_fieldwide_invariant(~) // set-as-set: cardinality vs max_elements

    // reaction = watch + (action | reflex)
    //   watch  = !name(scope)  — wakeup + condition
    //   action = >name(...)    — public; one-level or all-level; only when written explicitly
    //   reflex = ->>name() with no matching > — Internals; not for hand calls
    // ->>name(): action if >name exists, else reflex — never invent > from ->>
    // one = reaction of an object; all = reaction of a set as a set (rare)
    entity Clock
      one
        current: time

    attribute SpeedUpdate of SampleEntity
      always
        max_speed: integer = 3
      one
        speed: integer // increase of parent data_field per tick
      all
        *active_maintenance_call(~) // fast linear pass to clamp own values (alternative of local constraints)
        *active_working_call(~SampleEntity, tick_count: integer) // iterate own components and apply speed to paremt' data_field

    entity ReactionSketch
      one
        value: string
        !normalize(=one)
        !watch_clock(~Clock)->=field_update()
        !watch_self(~)
        !echo_sample(~SampleEntity)
        !watch_sample(~SampleEntity)->>reflex()
        !watch_trigger(~SampleEntity)->>field_action()
      all
        >field_action()

    attribute Tag of SampleEntity
      all
        modulus: integer
        !modulus_clamped(~) // set-as-set: Global modulus

    entity Reminder
      one
        target: affects<SampleEntity>
        trigger_value: integer
        !remove_after_happened(~)
        !write_log_when_reached(~SampleEntity)
      all
        >add_to(#SampleEntity, value: integer)->#

    component Remnant of Tag
      one
        power: integer @cache// == SampleEntity::data_field / Tag::Modulus (Tag quarantees integer)
        !sync(~Tag)

    component SampleComponent of SampleEntity
      one
        =example_op_multiply(factor: integer)
        =example_op_div_with_remainder(divisor: integer) -> integer

    attribute SampleAttribute of SampleEntity
      one
        main_anchor: anchor<Trivia> //@ any anchor<> / custody<> leads to custom Internals; affects<> is typed link (see Reminder)
        main_dummy: custody<Trivia>
      all
        >create(sample_value: integer)-># // reserved: minimal Aspect set including Identity source (Entity); here includes main_anchor Trivia
        >extend(existing: #SampleEntity)
        !limit_by_tag_count(~Tag) // set-as-set: cardinality vs Tag

    // experimental one-line form of syntax (sorry, parser!)
    entity Note one text: string

    group<Note> of SampleEntity

    // Hint: '=' functions aka "item modifiers" are meaningless for Archetype (has no own state/quantum)
    archetype Notebook
      ?notes_count(#SampleEntity)->integer
      >add_note(#SampleEntity, ~Note::text)-> #Note
